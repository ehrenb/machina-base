FROM alpine:3.23

RUN apk --update add --no-cache \
        alpine-sdk \
        bash \
        coreutils \
        freetype-dev \
        gcc \
        git \
        g++ \
        openssh-client \
        libffi-dev \
        libxml2-dev \
        libxml2 \
        libxslt \
        libxslt-dev \
        musl-dev \
        openssl \
        openssl-dev \
        python3 \
        python3-dev \
        py3-pip \
        geos-dev

ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV POETRY_VIRTUALENVS_CREATE=false

RUN pip3 install poetry

RUN mkdir /schemas
COPY binary.json /schemas/

COPY machina /machina
COPY ./wait-for-it.sh /machina/wait-for-it.sh
RUN cd /machina && poetry install


WORKDIR /machina

