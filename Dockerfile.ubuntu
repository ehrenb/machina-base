FROM ubuntu:noble

RUN apt-get update && \
    apt-get -y install \
        unzip \
        wget \
        gcc \
        git \
        g++ \
        libffi-dev \
        libxml2-dev \
        libxml2 \
        libxslt-dev \
        libssl-dev \
        musl-dev \
        openssh-client \
        openssl \
        python3 \
        python3-dev \
        python3-pip \
        libgeos-dev

ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV POETRY_VIRTUALENVS_CREATE=false

RUN pip3 install poetry

RUN mkdir /schemas
COPY binary.json /schemas/

COPY machina /machina
COPY ./wait-for-it.sh /machina/wait-for-it.sh
RUN cd /machina && poetry install


WORKDIR /machina
